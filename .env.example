# Local development only. Copy to .env for Compose; never use these values in deployed environments.
POSTGRES_DB=dental_dev
POSTGRES_USER=dental_dev
POSTGRES_PASSWORD=local-only-dev-password
DATABASE_URL=postgresql+psycopg://dental_dev:local-only-dev-password@db:5432/dental_dev
APP_ENV=development
OTP_PROVIDER=console
AUTH_SESSION_TTL_SECONDS=3600
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_LOGIN_ATTEMPTS=5
AUTH_OTP_REQUESTS=3
AUTH_RATE_WINDOW_SECONDS=900
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_OTP_PEPPER=development-only-otp-pepper
AUTH_RATE_LIMIT_SECRET=development-only-rate-limit-secret
AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,https://127.0.0.1:3000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
CONSENT_POLICY_VERSION=
CLINICAL_STORAGE_ROOT=/var/private/clinical-documents
CLINICAL_SIGNING_KEY=development-only-clinical-signing-key
CLINICAL_MAX_UPLOAD_BYTES=10485760
CLINICAL_SIGNED_URL_TTL_SECONDS=300
# Razorpay sandbox credentials only; never commit real values.
RAZORPAY_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILE_AFTER_SECONDS=600
# Notification adapter is deployment-provided as a Python module:callable factory.
NOTIFICATION_PROVIDER_FACTORY=
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_REMINDER_LEAD_MINUTES=
NOTIFICATION_REMINDER_TEMPLATE_KEY=
# AI remains disabled until a development placeholder opt-in or clinician-approved production ruleset exists.
AI_PROVIDER_FACTORY=
AI_ENABLE_PLACEHOLDER_RULES=false
AI_RATE_LIMIT_SECRET=development-only-ai-rate-limit-secret
AI_DAILY_QUOTA=50
AI_PER_MINUTE_LIMIT=5
AI_USAGE_RETENTION_DAYS=7
AI_MAX_COSINE_DISTANCE=0.35
