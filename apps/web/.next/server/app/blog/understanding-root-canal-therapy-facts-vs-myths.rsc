text-muted-foreground leading-relaxed","children":[["$","p","0",{"children":"Dental health myths often discourage patients from seeking timely endodontic care. A persistent throbbing toothache indicates that dental pulp—the soft neurovascular tissue at the centre of the tooth—has become infected by deep bacterial infiltration."}],["$","p","1",{"children":"Rather than extraction, root canal treatment preserves the natural tooth root within the alveolar bone. Maintaining natural dentition preserves chewing efficiency, jawbone density, and prevents adjacent teeth from drifting out of alignment."}],["$","p","2",{"children":"Modern endodontics incorporates electronic apex locators, high-torque rotary nickel-titanium files, and warm obturation techniques, making treatment comfortable and efficient."}]]}],["$","div",null,{"className":"p-6 rounded-xl bg-card border border-border mt-8 flex flex-col sm:flex-row items-center justify-between gap-6","children":[["$","div",null,{"className":"flex flex-col gap-1","children":[["$","h4",null,{"className":"font-serif text-lg font-bold text-foreground","children":"Experiencing Dental Symptoms?"}],["$","p",null,{"className":"text-xs text-muted-foreground","children":"Schedule a clinical diagnostic checkup with our specialist dental surgeons."}]]}],["$","$Ld",null,{"href":"/contact#book","children":["$","button",null,{"ref":"$undefined","disabled":false,"aria-busy":false,"className":"inline-flex items-center justify-center font-medium rounded-md transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none active:scale-[0.98] bg-primary text-primary-foreground hover:bg-primary-hover focus-visible:ring-primary focus-visible:ring-offset-background shadow-sm h-11 px-4 text-sm gap-2 min-h-[44px] shrink-0","children":[false,"Book Examination"]}]}]]}]]}],["$","aside",null,{"className":"lg:col-span-4 sticky top-28 flex fle