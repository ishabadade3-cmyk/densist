# Copy to .env.production on the deployment host, restrict permissions, and fill using
# approved policy values. This example contains no credentials or clinic facts.
PUBLIC_DOMAIN=
ACME_EMAIL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
BACKUP_DIRECTORY=
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_SECONDS=
BACKUP_RETENTION_DAYS=
BACKUP_TMP_SIZE_BYTES=

# Approved auth policy and generated secrets
AUTH_SESSION_TTL_SECONDS=
AUTH_OTP_TTL_SECONDS=
AUTH_OTP_MAX_ATTEMPTS=
AUTH_LOGIN_ATTEMPTS=
AUTH_OTP_REQUESTS=
AUTH_RATE_WINDOW_SECONDS=
AUTH_PASSWORD_MIN_LENGTH=
AUTH_OTP_PEPPER=
AUTH_RATE_LIMIT_SECRET=
OTP_PROVIDER=
MFA_ENCRYPTION_KEY=
CONSENT_POLICY_VERSION=

# Approved clinical storage policy and generated secret
CLINICAL_SIGNING_KEY=
CLINICAL_MAX_UPLOAD_BYTES=
CLINICAL_SIGNED_URL_TTL_SECONDS=

# Payment / notification / AI provider configuration. Keep sandbox credentials out of live mode.
RAZORPAY_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NOTIFICATION_PROVIDER_FACTORY=
AI_PROVIDER_FACTORY=
AI_RATE_LIMIT_SECRET=
AI_DAILY_QUOTA=
AI_PER_MINUTE_LIMIT=
AI_USAGE_RETENTION_DAYS=
AI_MAX_COSINE_DISTANCE=

# Production backup encryption private identity must be stored separately from this file.
# The public recipient above is safe to configure here; the identity never is.
